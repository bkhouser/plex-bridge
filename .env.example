# JSON arrays are required for list values. No real credentials belong here.
PA_PLEX_URL=http://127.0.0.1:32400
PA_PLEX_ALLOWED_HOSTS=["127.0.0.1"]
PA_PLEX_TOKEN=replace-with-private-plex-token
PA_PLEX_ACCOUNT_ID=123456
PA_PLEX_USERNAME=replace-with-exact-username
PA_PLEX_SERVER_ID=replace-with-machineIdentifier-from-discover
# Set only after checking discover's local account row against your Plex account.
# This is NOT the cloud account ID above. Omit to disable history import.
# PA_PLEX_HISTORY_ACCOUNT_ID=1
# PA_PLEX_HISTORY_ACCOUNT_NAME=exact-local-account-name-from-discover
# Set true only after verifying the cloud/local profile binding in Plex.
# PA_HISTORY_BINDING_CONFIRMED=true
# Run discover before setting these IDs. Cloud and local history IDs are distinct.
PA_LIBRARY_SECTIONS=[1]
PA_DATABASE_PATH=data/plex-advisor.sqlite
PA_SYNC_INTERVAL_SECONDS=14400
PA_TIMEOUT_SECONDS=20
PA_PAGE_SIZE=200
PA_TIMEZONE=America/New_York
PA_MCP_HOST=127.0.0.1
PA_MCP_PORT=8765
PA_AUTH_MODE=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PA_LOCAL_BEARER_TOKEN=replace-with-at-least-32-random-characters
PA_LOG_LEVEL=INFO
# Remote/tunnel deployment: set auth mode oauth and configure all fields below.
# PA_AUTH_MODE=oauth
# PA_OAUTH_ISSUER=https://your-tenant.example.com/
# PA_OAUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# PA_OAUTH_RESOURCE=https://your-approved-mcp-host.example.com/mcp
# PA_OAUTH_SUBJECT=your-exact-identity-provider-subject
# PA_MCP_ALLOWED_HOSTS=["your-approved-mcp-host.example.com"]
